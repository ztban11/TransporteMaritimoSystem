@model IEnumerable<TransporteMaritimoSystem.Models.UsuarioDTO>

@{
    ViewData["Title"] = "Gestión de Roles";
}

<h2 class="mb-4">Gestión de Roles de Usuarios</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th style="width:180px;">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.iUsuarioId</td>
                    <td>@user.sNombre</td>
                    <td>@user.sEmail</td>

                    <td>
                        <a class="btn btn-primary btn-sm"
                               asp-controller="Roles"
                               asp-action="Edit"
                               asp-route-id="@user.iUsuarioId">
                            Editar Roles
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">
                    No hay usuarios registrados.
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">

    <a asp-controller="HistorialRoles"
           asp-action="Index"
           class="btn btn-info me-2">
        Ver Historial de Cambios
    </a>

    <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
        Volver
    </a>

</div>