@model TransporteMaritimo.Core.Models.OrdenServicio

<h2>Nueva Orden de Servicio</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Barco</label>

        <select asp-for="BarcoId" class="form-control" required>

            <option value="">Seleccione un barco</option>

            @foreach (var barco in ViewBag.Barcos)
            {
                <option value="@barco.BarcoId">
                    @barco.NombreBarco
                </option>
            }

        </select>
    </div>

    <div class="form-group">
        <label>Tipo Mantenimiento</label>

        <select asp-for="TipoMantenimiento" class="form-control">
            <option>Preventivo</option>
            <option>Correctivo</option>
        </select>
    </div>

    <div class="form-group">
        <label>Prioridad</label>

        <select asp-for="Prioridad" class="form-control">
            <option>Alta</option>
            <option>Media</option>
            <option>Baja</option>
        </select>
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Fecha Límite</label>
        <input asp-for="FechaLimite" type="datetime-local" class="form-control" />
    </div>

    <br>

    <button class="btn btn-primary">Crear Orden</button>

</form>
