@model TransporteMaritimoSystem.Models.LoginViewModel


<div class="login-container">

    <div class="login-box">

        <h2>Login Sistema Transporte Marítimo</h2>

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <form asp-action="Login" method="post">

            <div>
                <label>Usuario</label>
                <input asp-for="sNombre" />
            </div>

            <br />

            <div>
                <label>Contraseña</label>
                <input asp-for="sPassword" type="password" />
            </div>

            <br />

            <button type="submit">Ingresar</button>

        </form>

    </div>

</div>
