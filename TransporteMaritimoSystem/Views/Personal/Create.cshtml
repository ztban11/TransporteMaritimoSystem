@model TransporteMaritimo.Core.Models.Personal

<h2>Registrar Personal</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Nombre Completo</label>
        <input asp-for="NombreCompleto" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Identificación</label>
        <input asp-for="Identificacion" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Rol Primario</label>
        <select asp-for="RolPrimario" class="form-control">
            <option value="Capitan">Capitán</option>
            <option value="Ingeniero">Ingeniero</option>
            <option value="Marinero">Marinero</option>
            <option value="PersonalBase">Personal Base</option>
        </select>
    </div>

    <div class="form-group">
        <label>Fecha Contratación</label>
        <input asp-for="FechaContratacion" type="date" class="form-control" required />
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-controller="Personal" asp-action="Index" class="btn btn-secondary">
        Regresar
    </a>

</form>

@if (ViewBag.Error != null)
{
    <div style="color:red;font-weight:bold">
        @ViewBag.Error
    </div>
}